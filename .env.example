# Copy to .env.local and fill in real values. Never commit .env.local.

# Public (exposed to the browser) — Supabase project URL and anon key only.
# Local development: run `pnpm db:start`, then `pnpm db:env` and copy the two values it prints.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never reference from "use client" files.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
